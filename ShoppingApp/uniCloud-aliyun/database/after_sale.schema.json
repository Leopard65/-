{
  "bsonType": "object",
  "required": ["user_id", "order_id", "status"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": { "description": "ID，系统自动生成" },
    "aftersale_no": { "bsonType": "string", "description": "售后单号" },
    "user_id": { "bsonType": "string", "description": "用户 ID" },
    "order_id": { "bsonType": "string", "description": "订单 ID" },
    "prev_order_status": { "bsonType": "int", "description": "申请售后前的订单状态,用于拒绝/取消时恢复" },
    "goods_ids": { "bsonType": "array", "description": "商品 ID 列表", "items": { "bsonType": "string" } },
    "goods_list": { "bsonType": "array", "description": "商品快照" },
    "type": { "bsonType": "string", "description": "售后类型：refund/return" },
    "reason": { "bsonType": "string", "description": "原因" },
    "refund_amount": { "bsonType": "double", "description": "退款金额" },
    "description": { "bsonType": "string", "description": "补充说明" },
    "images": { "bsonType": "array", "description": "凭证图片", "items": { "bsonType": "string" } },
    "status": { "bsonType": "int", "description": "状态：0-待审核，1-已同意，2-已拒绝，3-退货中，4-已完成，5-已取消" },
    "audit_result": { "bsonType": "string", "description": "审核结果" },
    "audit_remark": { "bsonType": "string", "description": "审核备注" },
    "audit_time": { "bsonType": "timestamp", "description": "审核时间" },
    "admin_remark": { "bsonType": "string", "description": "最近一次运营备注" },
    "admin_remarks": {
      "bsonType": "array",
      "description": "运营备注历史",
      "items": {
        "bsonType": "object",
        "properties": {
          "operator_id": { "bsonType": "string" },
          "operator_name": { "bsonType": "string" },
          "remark": { "bsonType": "string" },
          "create_date": { "bsonType": "timestamp" }
        }
      }
    },
    "refund_no": { "bsonType": "string", "description": "退款单号" },
    "complete_time": { "bsonType": "timestamp", "description": "完成时间" },
    "cancel_reason": { "bsonType": "string", "description": "取消原因" },
    "cancel_time": { "bsonType": "timestamp", "description": "取消时间" },
    "create_date": { "bsonType": "timestamp", "description": "创建时间" },
    "update_date": { "bsonType": "timestamp", "description": "更新时间" }
  }
}
