{
  "bsonType": "object",
  "required": ["user_id", "goods_id"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "user_id": {
      "bsonType": "string",
      "description": "用户ID"
    },
    "goods_id": {
      "bsonType": "string",
      "description": "商品ID"
    },
    "sku_id": {
      "bsonType": "string",
      "description": "SKU ID"
    },
    "goods_name": {
      "bsonType": "string",
      "description": "商品名称"
    },
    "goods_image": {
      "bsonType": "string",
      "description": "商品图片"
    },
    "price": {
      "bsonType": "double",
      "description": "单价"
    },
    "quantity": {
      "bsonType": "int",
      "description": "数量",
      "minimum": 1
    },
    "stock": {
      "bsonType": "int",
      "description": "库存"
    },
    "sku_info": {
      "bsonType": "string",
      "description": "规格信息"
    },
    "checked": {
      "bsonType": "bool",
      "description": "是否选中"
    },
    "create_date": {
      "bsonType": "timestamp",
      "description": "创建时间"
    },
    "update_date": {
      "bsonType": "timestamp",
      "description": "更新时间"
    }
  }
}
