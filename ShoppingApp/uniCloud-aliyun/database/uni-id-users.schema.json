      "description": "账号状态：active/cancel_requested/disabled/demo_cancel_requested"
    },
    "account_cancel_request": {
      "bsonType": "object",
      "description": "账号注销申请记录"
    },
    "privacy_settings": {
      "bsonType": "object",
      "description": "隐私授权偏好"
    },
    "register_date": {
      "bsonType": "timestamp",
      "description": "注册时间"
    },
    "create_date": {
      "bsonType": "timestamp",
      "description": "创建时间"
    },
    "update_date": {
      "bsonType": "timestamp",
      "description": "更新时间"
    }
