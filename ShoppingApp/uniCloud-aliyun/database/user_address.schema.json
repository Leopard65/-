{
  "bsonType": "object",
  "required": ["user_id", "name", "phone", "province", "city", "district", "detail"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "user_id": {
      "bsonType": "string",
      "description": "用户ID"
    },
    "name": {
      "bsonType": "string",
      "description": "收货人姓名",
      "maxLength": 50
    },
    "phone": {
      "bsonType": "string",
      "description": "手机号",
      "maxLength": 11
    },
    "province": {
      "bsonType": "string",
      "description": "省份"
    },
    "city": {
      "bsonType": "string",
      "description": "城市"
    },
    "district": {
      "bsonType": "string",
      "description": "区/县"
    },
    "detail": {
      "bsonType": "string",
      "description": "详细地址",
      "maxLength": 200
    },
    "is_default": {
      "bsonType": "bool",
      "description": "是否默认地址"
    },
    "create_date": {
      "bsonType": "timestamp",
      "description": "创建时间"
    },
    "update_date": {
      "bsonType": "timestamp",
      "description": "更新时间"
    }
  }
}
