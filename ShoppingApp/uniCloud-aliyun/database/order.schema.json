{
  "bsonType": "object",
  "required": ["order_no", "user_id", "status"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "order_no": {
      "bsonType": "string",
      "description": "订单号"
    },
    "request_id": {
      "bsonType": "string",
      "description": "前端提交幂等 ID，用于防重复下单"
    },
    "user_id": {
      "bsonType": "string",
      "description": "用户ID"
    },
    "status": {
      "bsonType": "int",
      "description": "订单状态：0-待支付，1-待发货，2-待收货，3-待评价，4-已完成，5-售后中，6-已取消",
      "enum": [0, 1, 2, 3, 4, 5, 6]
    },
    "total_amount": {
      "bsonType": "double",
      "description": "商品总金额"
    },
    "freight": {
      "bsonType": "double",
      "description": "运费"
    },
    "discount_amount": {
      "bsonType": "double",
      "description": "优惠金额"
    },
    "pay_amount": {
      "bsonType": "double",
      "description": "实付金额"
    },
    "address": {
      "bsonType": "object",
      "description": "收货地址",
      "properties": {
        "name": { "bsonType": "string" },
        "phone": { "bsonType": "string" },
        "province": { "bsonType": "string" },
        "city": { "bsonType": "string" },
        "district": { "bsonType": "string" },
        "detail": { "bsonType": "string" }
      }
    },
    "goods_list": {
      "bsonType": "array",
      "description": "商品列表",
      "items": {
        "bsonType": "object",
        "properties": {
          "goods_id": { "bsonType": "string" },
          "sku_id": { "bsonType": "string" },
          "goods_name": { "bsonType": "string" },
          "name": { "bsonType": "string" },
          "goods_image": { "bsonType": "string" },
          "image": { "bsonType": "string" },
          "price": { "bsonType": "double" },
          "quantity": { "bsonType": "int" },
          "subtotal": { "bsonType": "double" },
          "sku_info": { "bsonType": "string" }
        }
      }
    },
    "coupon_id": {
      "bsonType": "string",
      "description": "优惠券ID"
    },
    "user_coupon_id": {
      "bsonType": "string",
      "description": "用户优惠券领取记录ID"
    },
    "remark": {
      "bsonType": "string",
      "description": "订单备注"
    },
    "admin_remark": {
      "bsonType": "string",
      "description": "最近一次运营备注"
    },
    "admin_remarks": {
      "bsonType": "array",
      "description": "运营备注历史",
      "items": {
        "bsonType": "object",
        "properties": {
          "operator_id": { "bsonType": "string" },
          "operator_name": { "bsonType": "string" },
          "remark": { "bsonType": "string" },
          "create_date": { "bsonType": "timestamp" }
        }
      }
    },
    "pay_method": {
      "bsonType": "string",
      "description": "支付方式"
    },
    "pay_time": {
      "bsonType": "timestamp",
      "description": "支付时间"
    },
    "ship_time": {
      "bsonType": "timestamp",
      "description": "发货时间"
    },
    "logistics_company": {
      "bsonType": "string",
      "description": "物流公司"
    },
    "tracking_no": {
      "bsonType": "string",
      "description": "物流单号"
    },
    "confirm_time": {
      "bsonType": "timestamp",
      "description": "确认收货时间"
    },
    "evaluate_time": {
      "bsonType": "timestamp",
      "description": "评价时间"
    },
    "aftersale_time": {
      "bsonType": "timestamp",
      "description": "售后申请时间"
    },
    "aftersale_reject_time": {
      "bsonType": "timestamp",
      "description": "售后拒绝时间"
    },
    "aftersale_cancel_time": {
      "bsonType": "timestamp",
      "description": "售后取消时间"
    },
    "refund_time": {
      "bsonType": "timestamp",
      "description": "退款完成时间"
    },
    "cancel_reason": {
      "bsonType": "string",
      "description": "取消原因"
    },
    "cancel_time": {
      "bsonType": "timestamp",
      "description": "取消时间"
    },
    "pay_expire_time": {
      "bsonType": "timestamp",
      "description": "支付过期时间"
    },
    "cart_remove_error": {
      "bsonType": "string",
      "description": "下单成功后清理购物车失败的诊断摘要"
    },
    "create_date": {
      "bsonType": "timestamp",
      "description": "创建时间"
    },
    "update_date": {
      "bsonType": "timestamp",
      "description": "更新时间"
    }
  }
}
