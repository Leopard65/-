{
  "bsonType": "object",
  "required": ["name", "status"],
  "permission": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "name": {
      "bsonType": "string",
      "description": "分类名称",
      "maxLength": 50
    },
    "parent_id": {
      "bsonType": "string",
      "description": "父级分类ID，为空表示一级分类"
    },
    "icon": {
      "bsonType": "string",
      "description": "分类图标"
    },
    "image": {
      "bsonType": "string",
      "description": "分类图片"
    },
    "status": {
      "bsonType": "int",
      "description": "状态：0-禁用，1-启用",
      "enum": [0, 1]
    },
    "sort": {
      "bsonType": "int",
      "description": "排序值",
      "minimum": 0
    },
    "create_date": {
      "bsonType": "timestamp",
      "description": "创建时间"
    },
    "update_date": {
      "bsonType": "timestamp",
      "description": "更新时间"
    }
  }
}
